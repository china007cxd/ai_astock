# DeepSeek API Key（文本模型与视觉模型共用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 文本模型与视觉模型（视觉为实验版，K线截图理解专用）
TEXT_MODEL=deepseek-chat
VISION_MODEL=deepseek-v4-flash-vision-exp
# astock 看盘服务地址（需先启动 astock 目录下的 启动.bat）
ASTOCK_BASE=http://127.0.0.1:8765
# agent 自身监听地址
AGENT_HOST=127.0.0.1
AGENT_PORT=8766
